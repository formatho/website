{
  "resource": "https://mcp.formatho.com",
  "authorization_servers": [
    "https://formatho.com"
  ],
  "scopes_supported": [
    "tools:read",
    "tools:execute"
  ],
  "bearer_methods_supported": [
    "header"
  ],
  "resource_documentation": "https://formatho.com/auth.md",
  "token_endpoint_auth_methods_supported": [
    "none"
  ],
  "description": "Formatho Runtime MCP server. Authentication via API keys (see auth.md). Anonymous tier available with rate limits.",
  "anonymous_access": {
    "available": true,
    "rate_limit": {
      "burst": 20,
      "requests_per_minute": 30
    },
    "credential_types_supported": [
      "rate_limit_key"
    ]
  },
  "agent_auth": {
    "skill": "https://formatho.com/auth.md",
    "register_uri": "https://formatho.com/auth.md#registration",
    "identity_types_supported": [
      "anonymous",
      "api_key"
    ],
    "anonymous": {
      "credential_types_supported": [
        "rate_limit_key"
      ],
      "claim_uri": "https://formatho.com/auth.md#anonymous-rate-limited"
    },
    "api_key": {
      "credential_types_supported": [
        "bearer_token"
      ],
      "claim_uri": "https://formatho.com/auth.md#api-key-bearer-token",
      "registration_endpoint": "https://formatho.com/auth.md#registration"
    },
    "methods": [
      {
        "type": "api_key",
        "method": "static_bearer",
        "description": "Bearer token mapped to an agent identity with per-tool policy scope",
        "registration_endpoint": "https://formatho.com/auth.md#registration",
        "documentation": "https://formatho.com/auth.md",
        "claim_uri": "https://formatho.com/auth.md#method-api-key-bearer-token",
        "credential_types_supported": [
          "bearer_token"
        ]
      },
      {
        "type": "anonymous",
        "method": "rate_limit",
        "description": "Rate-limited access without credentials (30 req/min per IP)",
        "documentation": "https://formatho.com/auth.md",
        "claim_uri": "https://formatho.com/auth.md#method-anonymous-rate-limited",
        "credential_types_supported": [
          "rate_limit_key"
        ]
      }
    ]
  },
  "www_authenticate": "Bearer realm=\"formatho\", resource_metadata=\"https://formatho.com/.well-known/oauth-protected-resource\""
}